# Generated by Cargo
# will have compiled files and executables
/target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk
__pycache__/
.vscode/
.idea/
examples/demo/target/
rs_lvgl_sys/target/
rs_lvgl/target/

# Rspress site dependencies and generated output.
/website/node_modules/
/website/doc_build/

# Publish usage documentation; keep local plans and handoffs in the checkout.
/docs/*
!/docs/ai-skills.md
!/docs/component-studio.md
!/docs/testing.md
!/docs/images/
/docs/images/*
!/docs/images/*.png

# Browser studio binaries are reproducible build outputs.
/website/docs/public/wasm/
!/website/wasm/Cargo.lock

# Generated interactive playground modules
website/docs/public/playground-wasm/

# Local Archify candidates, generation receipts and browser evidence.
/.archify/
/.xuanling/